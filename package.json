{
  "name": "rhoto-router",
  "version": "0.4.1",
  "description": "a react router",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "repository": "github.com/jbr/rhoto-router",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "author": "jacob rothstein",
  "license": "MIT",
  "private": false,
  "type": "module",
  "peerDependencies": {
    "react": "^16.8 || ^17 || ^18 || ^19"
  },
  "scripts": {
    "build": "env NODE_ENV=production rollup -c ./rollup.config.js",
    "watch": "env NODE_ENV=development yarn rollup -c ./rollup.config.js --watch",
    "clean": "rm -rf dist/*",
    "build:clean": "yarn run clean && yarn run build",
    "prepublishOnly": "yarn build:clean"
  },
  "dependencies": {
    "path-to-regexp": "^8.3.0",
    "qs-esm": "^8.0.1"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.19.0",
    "prettier": "^3.7.4",
    "rollup": "^4.53.3",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
